{
  "name": "biz-dashboards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/dev.js",
    "dev:api": "node server/index.js",
